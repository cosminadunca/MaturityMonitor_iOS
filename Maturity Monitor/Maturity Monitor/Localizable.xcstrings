          }
        }
      }
    },
    "Weight: %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوزن: %@"
          }
        }
      }
    },
    "What legal basis do we have for processing your personal data?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما هو الأساس القانوني الذي نعتمد عليه لمعالجة بياناتك الشخصية؟"
          }
        }
      }
    },
    "White: Gypsy, Traveller, Roma, or Other White" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبيض: غجري، مسافر، رومي، أو أبيض آخر"
          }
        }
      }
    },
    "White: Irish" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبيض: إيرلندي"
          }
        }
      }
    },
    "White: UK or British" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبيض: المملكة المتحدة أو بريطاني"
          }
        }
      }
    },
    "Who are we?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من نحن؟"
          }
        }
      }
    },
    "Will be available soon..." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتوفر قريبًا..."
          }
        }
      }
    },
    "Would you like to see a growth representation (Path to Adulthood) generated by AI (Artificial Intelligence) based on path recognition from the latest entry until the predicted adult height?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تود رؤية تمثيل لنمو الطفل (طريق إلى البلوغ) يتم إنشاؤه بواسطة الذكاء الاصطناعي بناءً على التعرف على المسار من آخر إدخال حتى الطول المتوقع عند البلوغ؟"
          }
        }
      }
    },
    "Yemen" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليمن"
          }
        }
      }
    },
    "Yes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نعم"
          }
        }
      }
    },
    "You also have the right to complain to the Information Commissioner's Office (ICO) about the way in which we process your personal data. Details can be found at: " : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك أيضًا الحق في تقديم شكوى إلى مكتب مفوض المعلومات (ICO) بشأن الطريقة التي نعالج بها بياناتك الشخصية. يمكن العثور على التفاصيل على:"
          }
        }
      }
    },
    "You can only edit children accounts that you have created! " : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تعديل حسابات الأطفال التي أنشأتها فقط!"
          }
        }
      }
    },
    "Zambia" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زامبيا"
          }
        }
      }
    },
    "Zimbabwe" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {

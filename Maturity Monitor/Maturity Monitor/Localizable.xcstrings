    "Maturity Monitor" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maturity Monitor"
          }
        }
      }
    },
    "Maturity Timing (Early On-Time, Late) – This is calculated by the offset between your chronological age and biological age and represents whether the individual is ahead of typical or delayed in their maturity timing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقيت النضج (مبكر، في الوقت المحدد، متأخر) – يتم حساب ذلك من خلال الفارق بين العمر الزمني والعمر البيولوجي ويعكس ما إذا كان الفرد متقدماً عن النمو المعتاد أو متأخراً في توقيت نضجه."
          }
        }
      }
    },
    "Mauritania" : {
      "localizations" : {
        "ar" : {
